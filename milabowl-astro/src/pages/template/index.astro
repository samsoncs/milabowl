---
import type { FplResults } from '../../game_state/fplState';
import Layout from '../../layouts/Layout.astro';
import fplState from '../../game_state/fpl_state.json';
import Card from '../../components/core/Card.astro';

const fplResults: FplResults = fplState;
const templateTeamNames = [
  'Infantino dictatino',
  'Sels Sarr Salaht',
  'Valg må tas',
];
const [template] = fplResults.results
  .filter((result) => templateTeamNames.includes(result.teamName))
  .sort((a, b) => b.gameWeek - a.gameWeek);
const lineup = template?.lineup;
const positions = [
  { code: 'GK', label: 'GK' },
  { code: 'DEF', label: 'Def' },
  { code: 'MID', label: 'Mid' },
  { code: 'FWD', label: 'Fwd' },
];
---

<Layout title="Template Team">
  <Card title="Template of the week">
    {
      lineup?.length ? (
        <div class="flex flex-col gap-4">
          {positions.map(({ code, label }) => (
            <div class="flex flex-col gap-2">
              <div class="text-content-secondary font-bold">{label}</div>
              {lineup
                .filter((player) => player.position === code)
                .map((player) => (
                  <div class="bg-surface-2 rounded-md p-2">
                    {player.webName} {player.isCap ? '(C)' : ''}{' '}
                    {player.isViceCap ? '(VC)' : ''}{' '}
                    {player.isBench ? '(Bench)' : ''}
                  </div>
                ))}
            </div>
          ))}
        </div>
      ) : (
        <p class="text-content-secondary">
          No template lineup is available yet.
        </p>
      )
    }
  </Card>
</Layout>
